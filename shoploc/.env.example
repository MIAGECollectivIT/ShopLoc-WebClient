# ==============================================================================
# Variables d'environnement - ShopLoc Web App (Astro SSR + React)
# ==============================================================================

# URL du backend / Gateway pour les appels API (SSR et proxy)
INTERNAL_API_URL=http://localhost:8080

# Cible du proxy de développement Vite ('astro dev')
DEV_BACKEND_URL=http://localhost:8080

# URLs des microservices individuels (pointent vers la Gateway :8080 en dev local)
USERS_SERVICE_URL=http://localhost:8080
STORE_SERVICE_URL=http://localhost:8080
SALES_SERVICE_URL=http://localhost:8080
LOYALTY_SERVICE_URL=http://localhost:8080
OBSERVABILITY_SERVICE_URL=http://localhost:8080

# ==============================================================================
# SÉCURITÉ JWT (Vérification Asymétrique RSA RS256)
# ==============================================================================
# Clé publique RSA 2048-bit (X.509 SPKI Base64) - Fournie par Users-Service
# Permet au Middleware Astro SSR de vérifier l'authenticité des jetons de session.
# Paire de clés standard pour l'environnement de développement local :
JWT_PUBLIC_
