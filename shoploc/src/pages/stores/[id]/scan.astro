---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { getStoreById } from '../../../lib/api';
import { ROUTES } from '../../../config/routes';
import { ArrowLeft, Store as StoreIcon } from 'lucide-react';
import { buttonVariants } from '../../../components/ui/button';
import { MerchantLoyaltyScanner } from '../../../components/MerchantLoyaltyScanner';

const { id } = Astro.params;
const store = id ? await getStoreById(id).catch(() => null) : null;
---

<Layout title={store ? `Pass Caisse - ${store.name}` : 'Pass Caisse'}>
  <main class="max-w-4xl mx-auto p-4 sm:p-6 space-y-6">
    <div>
      <a
        href={id ? ROUTES.storeDetail(id) : ROUTES.stores.path}
        class={buttonVariants({ variant: 'ghost', size: 'sm' })}
      >
        <ArrowLeft className="size-4 mr-1" /> Retour au magasin
      </a>
    </div>

    {store && (
      <div class="space-y-6">
        <MerchantLoyaltyScanner
          client:only="react"
          storeId={Number(store.id)}
          storeName={store.name}
        />
      </div>
    )}

    {!store && (
      <div class="text-center py-16 bg-card border border-border rounded-xl space-y-2">
        <StoreIcon className="size-10 text-muted-foreground mx-auto" />
        <h2 class="text-base font-semibold">Boutique introuvable</h2>
        <p class="text-xs text-muted-foreground">
          L'établissement demandé n'existe pas ou n'est plus accessible.
        </p>
      </div>
    )}
  </main>
</Layout>
