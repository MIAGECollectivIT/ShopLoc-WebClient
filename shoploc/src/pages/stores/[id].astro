---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { Card, CardHeader, CardTitle, CardDescription } from '../../components/ui/card';
import { buttonVariants } from '../../components/ui/button';
import { getStoreById } from '../../lib/api';
import { resolveStoreImageUrl } from '../../lib/image';
import { ROUTES } from '../../config/routes';
import { ArrowLeft, MapPin, Store as StoreIcon } from 'lucide-react';
import type { Store } from '../../types/store';
import { StoreProductsView } from '../../components/StoreProductsView';

const { id } = Astro.params;
const { store: initialStore } = Astro.props as { store?: Store };
const store = initialStore ?? (id ? await getStoreById(id).catch(() => null) : null);
---

<Layout title={store?.name || 'Détail boutique'}>
  <main class="max-w-5xl mx-auto p-4 sm:p-6 space-y-6">
    <div>
      <a href={ROUTES.stores.path} class={buttonVariants({ variant: 'ghost', size: 'sm' })}>
        <ArrowLeft className="size-4 mr-1" /> Retour aux boutiques
      </a>
    </div>

    {store && (
      <div class="space-y-6">
        {/* Store Banner Card */}
        <Card className="overflow-hidden border-border bg-card">
          {resolveStoreImageUrl(store.url, store.uid || store.id) ? (
            <img
              src={resolveStoreImageUrl(store.url, store.uid || store.id)}
              alt={store.name}
              class="h-64 sm:h-72 w-full object-cover"
            />
          ) : (
            <div class="h-44 bg-muted/60 flex flex-col items-center justify-center text-muted-foreground">
              <StoreIcon className="size-10 stroke-1 mb-1 text-muted-foreground/60" />
              <span class="text-xs">Pas d'image d'établissement</span>
            </div>
          )}

          <CardHeader className="p-4 sm:p-6">
            <CardTitle className="text-2xl font-bold text-foreground">{store.name}</CardTitle>
            <CardDescription className="flex items-center gap-1.5 text-sm mt-1">
              <MapPin className="size-4 shrink-0 text-primary" />
              <span>{store.address}</span>
            </CardDescription>
          </CardHeader>
        </Card>

        {/* Dynamic Catalog Section (Merchant Dashboard or Customer Storefront) */}
        <StoreProductsView client:only="react" store={store} />
      </div>
    )}

    {!store && (
      <div class="text-center py-16 bg-card border border-border rounded-xl space-y-2">
        <StoreIcon className="size-10 text-muted-foreground mx-auto" />
        <h2 class="text-base font-semibold">Boutique introuvable</h2>
        <p class="text-xs text-muted-foreground">
          L'établissement demandé n'existe pas ou n'est plus accessible.
        </p>
      </div>
    )}
  </main>
</Layout>
