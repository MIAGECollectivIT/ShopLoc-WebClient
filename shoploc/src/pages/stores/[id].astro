---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { Card, CardHeader, CardTitle, CardDescription } from '../../components/ui/card';
import { buttonVariants } from '../../components/ui/button';
import { getStoreById } from '../../lib/api';
import { resolveStoreImageUrl } from '../../lib/image';
import { ROUTES } from '../../config/routes';
import { ArrowLeft, MapPin, Store as StoreIcon } from 'lucide-react';
import type { Store } from '../../types/store';
import { StoreProductsView } from '../../components/StoreProductsView';
import { StoreOpenStatusBadge } from '../../components/StoreOpenStatusBadge';

const { id } = Astro.params;
const { store: initialStore } = Astro.props as { store?: Store };
const store = initialStore ?? (id ? await getStoreById(id).catch(() => null) : null);

// Canonical redirect to UUID if store was accessed with numeric DB id
if (store?.uid && id && /^\d+$/.test(id)) {
  return Astro.redirect(ROUTES.storeDetail(store.uid));
}
---

<Layout title={store?.name || 'Détail boutique'}>
  <main class="max-w-5xl mx-auto p-4 sm:p-6 space-y-6">
    <div>
      <a href={ROUTES.stores.path} class={buttonVariants({ variant: 'ghost', size: 'sm' })}>
        <ArrowLeft className="size-4 mr-1" /> Retour aux boutiques
      </a>
    </div>

    {store && store.status === 'REVOKED' && (
      <div class="rounded-xl border border-destructive/40 bg-destructive/10 p-4 sm:p-5 flex items-start gap-3 text-destructive shadow-xs">
        <div class="p-2 rounded-lg bg-destructive/15 shrink-0 mt-0.5">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-5"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="m4.9 4.9 14.2 14.2" />
          </svg>
        </div>
        <div class="space-y-1">
          <h3 class="font-bold text-sm sm:text-base leading-tight">
            Commerce Partenaire Neutralisé (Statut : REVOKED)
          </h3>
          <p class="text-xs sm:text-sm text-destructive/90 leading-relaxed">
            Ce commerce ne fait plus partie du programme d'animation ShopLoc. Le catalogue en ligne,
            les ventes physiques et les commandes Click & Collect sont définitivement suspendus pour
            cet établissement.
          </p>
        </div>
      </div>
    )}

    {store && (
      <div class="space-y-6">
        {/* Store Banner Card with Real-time Open/Closed Badge and Schedule */}
        <Card className="overflow-hidden border-border bg-card shadow-xs">
          <div class="relative">
            {resolveStoreImageUrl(store.url, store.uid || store.id) ? (
              <img
                src={resolveStoreImageUrl(store.url, store.uid || store.id)}
                alt={store.name}
                class="h-64 sm:h-72 w-full object-cover"
              />
            ) : (
              <div class="h-44 bg-muted/60 flex flex-col items-center justify-center text-muted-foreground">
                <StoreIcon className="size-10 stroke-1 mb-1 text-muted-foreground/60" />
                <span class="text-xs">Pas d'image d'établissement</span>
              </div>
            )}

            {/* Floating Open Badge on Banner (only when open) */}
            <div class="absolute top-3 right-3 drop-shadow-sm">
              <StoreOpenStatusBadge
                client:load
                openingHours={store.openingHours}
                absenceStartDate={store.absenceStartDate}
                absenceEndDate={store.absenceEndDate}
                absenceReason={store.absenceReason}
                absences={store.absences}
                showScheduleDropdown={false}
                onlyWhenOpen={true}
              />
            </div>
          </div>

          <CardHeader className="p-4 sm:p-6 space-y-3">
            <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
              <div class="space-y-1">
                <CardTitle className="text-2xl font-bold text-foreground">{store.name}</CardTitle>
                <CardDescription className="flex items-center gap-1.5 text-sm">
                  <MapPin className="size-4 shrink-0 text-primary" />
                  <span>{store.address}</span>
                  {store.category && (
                    <span class="text-xs text-muted-foreground">&bull; {store.category}</span>
                  )}
                </CardDescription>
              </div>

              {/* Full schedule dropdown & absence notice */}
              <div class="shrink-0 md:max-w-md w-full md:w-auto">
                <StoreOpenStatusBadge
                  client:load
                  openingHours={store.openingHours}
                  absenceStartDate={store.absenceStartDate}
                  absenceEndDate={store.absenceEndDate}
                  absenceReason={store.absenceReason}
                  absences={store.absences}
                  showScheduleDropdown={true}
                />
              </div>
            </div>
          </CardHeader>
        </Card>

        {/* Dynamic Catalog Section (Merchant Dashboard or Customer Storefront) */}
        <StoreProductsView client:only="react" store={store} />
      </div>
    )}

    {!store && (
      <div class="text-center py-16 bg-card border border-border rounded-xl space-y-2">
        <StoreIcon className="size-10 text-muted-foreground mx-auto" />
        <h2 class="text-base font-semibold">Boutique introuvable</h2>
        <p class="text-xs text-muted-foreground">
          L'établissement demandé n'existe pas ou n'est plus accessible.
        </p>
      </div>
    )}
  </main>
</Layout>
