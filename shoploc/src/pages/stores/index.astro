---
import Layout from '../../layouts/Layout.astro';
import PageContainer from '../../components/PageContainer.astro';
import { ShopCard } from '../../components/ShopCard';
import {
  Empty,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
  EmptyDescription,
} from '../../components/ui/empty';
import { getShops } from '../../lib/api';
import { AlertCircle, Store } from 'lucide-react';
import type { Shop } from '../../types/shop';

let shops: Shop[] = [];
let error: string | null = null;

try {
  shops = await getShops();
} catch (err: unknown) {
  console.error('Erreur lors de la récupération des boutiques:', err);
  error = 'Impossible de récupérer les données des boutiques.';
}
---

<Layout
  title="Boutiques — ShopLoc"
  description="Découvrez l'ensemble des commerçants partenaires de votre municipalité."
>
  <PageContainer
    title="Commerçants partenaires"
    description="Découvrez l'ensemble des commerçants de votre municipalité et cumulez vos points fidélité."
    icon={Store}
  >
    {error && (
      <div class="border border-destructive p-4 text-destructive flex items-center gap-2">
        <AlertCircle className="size-4 shrink-0" />
        <p class="text-sm">{error}</p>
      </div>
    )}

    {!error && shops.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {shops.map((shop) => (
          <ShopCard shop={shop} />
        ))}
      </div>
    )}

    {!error && shops.length === 0 && (
      <Empty>
        <EmptyHeader>
          <EmptyMedia variant="icon">
            <Store />
          </EmptyMedia>
          <EmptyTitle>Aucune boutique trouvée</EmptyTitle>
          <EmptyDescription>
            Il n'y a pour le moment aucun commerçant enregistré dans votre zone.
          </EmptyDescription>
        </EmptyHeader>
      </Empty>
    )}
  </PageContainer>
</Layout>
