---
import Layout from '../../layouts/Layout.astro';
import PageContainer from '../../components/PageContainer.astro';
import { StoreCard } from '../../components/StoreCard';
import {
  Empty,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
  EmptyDescription,
} from '../../components/ui/empty';
import { getStores, getApiEndpoint } from '../../lib/api';
import { AlertCircle, Store } from 'lucide-react';
import type { Store as StoreType } from '../../types/store';

let stores: StoreType[] = [];
let error: string | null = null;
let debugInfo: string | null = null;
const targetRoute = getApiEndpoint('/v1/stores');

try {
  console.log(`[PAGE /stores] Début de la récupération des boutiques via la route: ${targetRoute}`);
  stores = await getStores();
  console.log(`[PAGE /stores] Récupération réussie: ${stores.length} boutique(s) trouvée(s).`);
} catch (err: unknown) {
  const errorMessage = err instanceof Error ? `${err.name}: ${err.message}` : String(err);
  console.error(`[PAGE /stores] Erreur lors de l'appel à [${targetRoute}]:`, err);
  error = 'Impossible de récupérer les données des boutiques.';
  debugInfo = `Route appelée: ${targetRoute}\nErreur: ${errorMessage}\nSTORE_SERVICE_URL / INTERNAL_API_URL: ${process.env.STORE_SERVICE_URL ?? process.env.INTERNAL_API_URL ?? '<non définie, fallback sur http://localhost:8080>'}`;
}
---

<Layout
  title="Boutiques — ShopLoc"
  description="Découvrez l'ensemble des commerçants partenaires de votre municipalité."
>
  <PageContainer
    title="Commerçants partenaires"
    description="Découvrez l'ensemble des commerçants de votre municipalité et cumulez vos points fidélité."
    icon={Store}
  >
    {error && (
      <div class="border border-destructive/50 bg-destructive/10 p-4 text-destructive space-y-1 rounded-lg">
        <div class="flex items-center gap-2 font-medium">
          <AlertCircle className="size-4 shrink-0" />
          <p class="text-sm">{error}</p>
        </div>
        {debugInfo && <pre class="text-xs opacity-80 font-mono mt-1 whitespace-pre-wrap break-all">{debugInfo}</pre>}
      </div>
    )}

    {!error && stores.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {stores.map((store) => (
          <StoreCard store={store} />
        ))}
      </div>
    )}

    {!error && stores.length === 0 && (
      <Empty>
        <EmptyHeader>
          <EmptyMedia variant="icon">
            <Store />
          </EmptyMedia>
          <EmptyTitle>Aucune boutique trouvée</EmptyTitle>
          <EmptyDescription>
            Il n'y a pour le moment aucun commerçant enregistré dans votre zone.
          </EmptyDescription>
        </EmptyHeader>
      </Empty>
    )}
  </PageContainer>
</Layout>
