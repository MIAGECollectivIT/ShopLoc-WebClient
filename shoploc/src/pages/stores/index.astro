---
import Layout from '../../layouts/Layout.astro';
import PageContainer from '../../components/PageContainer.astro';
import { StoreDirectoryView } from '../../components/StoreDirectoryView';
import { ButtonWithAuthorization } from '../../components/ui/ButtonWithAuthorization';
import { ROUTES } from '../../config/routes';
import { getStores, getApiEndpoint } from '../../lib/api';
import { Store } from 'lucide-react';
import type { Store as StoreType } from '../../types/store';

let stores: StoreType[] = [];
let error: string | null = null;
const targetRoute = getApiEndpoint('/v1/stores');

try {
  console.log(`[PAGE /stores] Début de la récupération des boutiques via la route: ${targetRoute}`);
  stores = await getStores();
  console.log(`[PAGE /stores] Récupération réussie: ${stores.length} boutique(s) trouvée(s).`);
} catch (err: unknown) {
  // Log internal details to server logs only to avoid exposing topology to end-users
  console.error(`[PAGE /stores] Erreur lors de l'appel à [${targetRoute}]:`, err);
  error = 'Impossible de récupérer les données des boutiques.';
}
---

<Layout
  title="Boutiques - ShopLoc"
  description="Découvrez l'ensemble des commerçants partenaires de votre municipalité."
>
  <PageContainer
    title="Commerçants partenaires"
    description="Découvrez l'ensemble des commerçants de votre municipalité, recherchez vos enseignes préférées et cumulez vos points fidélité."
    icon={Store}
  >
    <div class="flex items-center justify-end pb-2">
      <ButtonWithAuthorization
        client:only="react"
        allowedRoles={['ADMIN']}
        fallbackMode="remove"
        href={ROUTES.createStore.path}
        label="Ajouter un établissement"
        size="sm"
      />
    </div>

    <StoreDirectoryView client:load initialStores={stores} initialError={error} />
  </PageContainer>
</Layout>
