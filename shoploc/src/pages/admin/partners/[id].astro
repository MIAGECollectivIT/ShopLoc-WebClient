---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { AdminPartnerDetailView } from '../../../components/AdminPartnerDetailView';
import { getAdminPartnerById, getStoreById } from '../../../lib/api';
import { ROUTES } from '../../../config/routes';
import { Button } from '../../../components/ui/button';
import { ArrowLeft, AlertCircle } from 'lucide-react';
import type { AdminPartnerDetail } from '../../../types/partner';
import type { Store } from '../../../types/store';

const { id } = Astro.params;
const token = Astro.locals.token || '';

let partner: AdminPartnerDetail | null = null;
let initialStores: Store[] = [];
let errorMessage: string | null = null;

if (!id) {
  errorMessage = 'Identifiant de partenaire manquant.';
} else {
  try {
    partner = await getAdminPartnerById(id, token);
    if (partner.storeIds && partner.storeIds.length > 0) {
      const storeResults = await Promise.all(
        partner.storeIds.map(async (storeId) => {
          try {
            return await getStoreById(storeId);
          } catch {
            return {
              id: storeId,
              name: `Commerce #${storeId}`,
              address: 'Informations non disponibles',
            } as Store;
          }
        })
      );
      initialStores = storeResults;
    }
  } catch (err: unknown) {
    console.error(`[PAGE /admin/partners/${id}] Error fetching partner:`, err);
    errorMessage =
      err instanceof Error ? err.message : 'Partenaire commerçant introuvable ou inaccessible.';
  }
}

const pageTitle = partner
  ? `Partenaire - ${partner.companyName || partner.firstName || partner.email} - Administration`
  : 'Partenaire introuvable - Administration';
---

<Layout title={pageTitle}>
  <main class="max-w-5xl mx-auto p-4 sm:p-6 space-y-6">
    {partner && (
      <AdminPartnerDetailView client:load partner={partner} initialStores={initialStores} />
    )}

    {!partner && (
      <div class="space-y-4">
        <Button
          variant="ghost"
          size="sm"
          render={<a href={ROUTES.adminPartners.path} />}
          className="gap-2 text-muted-foreground hover:text-foreground"
        >
          <ArrowLeft className="size-4" />
          <span>Retour à la liste des partenaires</span>
        </Button>

        <div class="border rounded-xl p-12 text-center bg-card space-y-3">
          <AlertCircle className="size-10 text-destructive mx-auto" />
          <h2 class="text-lg font-semibold text-foreground">Partenaire introuvable</h2>
          <p class="text-sm text-muted-foreground max-w-md mx-auto">
            {errorMessage ||
              "Le compte commerçant partenaire demandé n'existe pas ou n'est plus accessible."}
          </p>
          <div class="pt-2">
            <Button variant="outline" size="sm" render={<a href={ROUTES.adminPartners.path} />}>
              Revenir aux partenaires
            </Button>
          </div>
        </div>
      </div>
    )}
  </main>
</Layout>
