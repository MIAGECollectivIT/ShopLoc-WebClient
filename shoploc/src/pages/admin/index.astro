---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import PageContainer from '../../components/PageContainer.astro';
import { AdminNavHeader } from '../../components/AdminNavHeader';
import { AdminUsersTab } from '../../components/AdminUsersTab';
import { getAdminUsers } from '../../lib/api';
import { ShieldCheck } from 'lucide-react';
import type { UserResponse } from '../../types/user';

const token = Astro.locals.token || '';
let initialUsers: UserResponse[] = [];

if (token) {
  try {
    const usersPage = await getAdminUsers({ page: 0, size: 12, authToken: token });
    initialUsers = usersPage.content || [];
  } catch (err: unknown) {
    console.warn('[PAGE /admin] Failed to fetch initial users server-side:', err);
  }
}
---

<Layout
  title="Supervision des comptes utilisateurs - Administration ShopLoc"
  description="Supervisez l'ensemble des comptes citoyens et commerçants enregistrés sur la plateforme."
>
  <PageContainer
    title="Supervision de l'écosystème"
    description="Consultez et administrez l'ensemble des comptes utilisateurs enregistrés et des commerces affiliés."
    icon={ShieldCheck}
  >
    <div class="space-y-6">
      <AdminNavHeader client:load activeNav="users" />
      <AdminUsersTab client:load initialUsers={initialUsers} />
    </div>
  </PageContainer>
</Layout>
