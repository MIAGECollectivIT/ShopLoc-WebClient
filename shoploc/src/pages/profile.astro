---
import Layout from '../layouts/Layout.astro';
import PageContainer from '../components/PageContainer.astro';
import { ClientProfileView } from '../components/ClientProfileView';
import { ROUTES } from '../config/routes';
---

<Layout
  title="Mon Profil Citoyen — ShopLoc"
  description="Consultez votre profil citoyen, vos plaques d'immatriculation, votre QR code et votre pass fidélité ShopLoc."
>
  <PageContainer
    title="Mon Profil Citoyen"
    description="Retrouvez vos informations personnelles, vos plaques d'immatriculation et votre pass fidélité pour vos passages en caisse."
    icon={ROUTES.profile.icon}
  >
    <ClientProfileView client:load />
  </PageContainer>
</Layout>
