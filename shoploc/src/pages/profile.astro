---
import Layout from '../layouts/Layout.astro';
import PageContainer from '../components/PageContainer.astro';
import { ClientProfileView } from '../components/ClientProfileView';
import { ROUTES } from '../config/routes';

const targetUserId = Astro.url.searchParams.get('userId') || undefined;
---

<Layout
  title="Profil — ShopLoc"
  description="Consultez les informations personnelles et les détails du profil sur la plateforme ShopLoc."
>
  <PageContainer
    title={targetUserId ? 'Profil Utilisateur' : 'Mon Profil'}
    description={
      targetUserId
        ? 'Consultation des informations du compte utilisateur ShopLoc.'
        : 'Retrouvez vos informations personnelles et les paramètres de votre compte ShopLoc.'
    }
    icon={ROUTES.profile.icon}
  >
    <ClientProfileView targetUserId={targetUserId} client:load />
  </PageContainer>
</Layout>
