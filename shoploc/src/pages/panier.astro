---
import Layout from '../layouts/Layout.astro';
import PageContainer from '../components/PageContainer.astro';
import {
  Empty,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
  EmptyDescription,
  EmptyContent,
} from '../components/ui/empty';
import { buttonVariants } from '../components/ui/button';
import { ShoppingCart, ShoppingBag } from 'lucide-react';
---

<Layout
  title="Mon Panier — ShopLoc"
  description="Retrouvez les articles ajoutés lors de vos commandes locales."
>
  <PageContainer
    title="Mon Panier"
    description="Retrouvez les articles ajoutés lors de vos commandes locales."
    icon={ShoppingCart}
  >
    <Empty>
      <EmptyHeader>
        <EmptyMedia variant="icon">
          <ShoppingBag />
        </EmptyMedia>
        <EmptyTitle>Votre panier est vide</EmptyTitle>
        <EmptyDescription>
          Explorez les commerçants de votre ville pour ajouter vos premiers produits.
        </EmptyDescription>
      </EmptyHeader>
      <EmptyContent>
        <a href="/catalogue" class={buttonVariants({ variant: 'default', size: 'sm' })}>
          Explorer le catalogue
        </a>
      </EmptyContent>
    </Empty>
  </PageContainer>
</Layout>
