---
import Layout from '../layouts/Layout.astro';
import PageContainer from '../components/PageContainer.astro';
import { CartPageView } from '../components/CartPageView';
import { ROUTES } from '../config/routes';
---

<Layout
  title="Mon Panier — ShopLoc"
  description="Consultez et validez vos articles Click & Collect regroupés par commerce partenaire."
>
  <PageContainer
    title="Mon Panier"
    description="Vérifiez les articles sélectionnés dans vos commerces de proximité et validez votre commande."
    icon={ROUTES.cart.icon}
  >
    <CartPageView client:load />
  </PageContainer>
</Layout>
