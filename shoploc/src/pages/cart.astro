---
import Layout from '../layouts/Layout.astro';
import PageContainer from '../components/PageContainer.astro';
import { PaymentSimulatorCard } from '../components/PaymentSimulatorCard';
import { ROUTES } from '../config/routes';
---

<Layout
  title="Mon Panier & Paiement — ShopLoc"
  description="Validez vos commandes locales et simulez vos paiements bancaires ShopLoc."
>
  <PageContainer
    title="Mon Panier & Paiement"
    description="Réglez vos achats Click & Collect, recharges ou sessions de stationnement via la passerelle bancaire émulée."
    icon={ROUTES.cart.icon}
  >
    <PaymentSimulatorCard client:load />
  </PageContainer>
</Layout>
