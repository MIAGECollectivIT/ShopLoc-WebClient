---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageContainer from '../components/PageContainer.astro';
import { ROUTES } from '../config/routes';
import { GlobalProductCatalog } from '../components/GlobalProductCatalog';
---

<Layout
  title="Catalogue des produits — ShopLoc"
  description="Consultez l'ensemble des offres et produits Click & Collect des commerçants partenaires."
>
  <PageContainer
    title="Catalogue Click & Collect"
    description="Retrouvez les produits disponibles immédiatement au retrait chez vos commerçants locaux."
    icon={ROUTES.catalog.icon}
  >
    <GlobalProductCatalog client:load />
  </PageContainer>
</Layout>
