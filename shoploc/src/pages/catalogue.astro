---
import Layout from '../layouts/Layout.astro';
import { BookOpen } from 'lucide-react';
---

<Layout title="Catalogue — ShopLoc">
  <main class="max-w-5xl mx-auto p-4 sm:p-6 space-y-4">
    <div class="flex items-center gap-3 border-b pb-4">
      <BookOpen className="size-6 text-primary" />
      <div>
        <h1 class="text-xl font-bold tracking-tight">Catalogue des produits</h1>
        <p class="text-xs text-muted-foreground">
          Consultez l'ensemble des offres et produits des commerçants partenaires.
        </p>
      </div>
    </div>

    <div class="rounded-lg border border-dashed p-8 text-center text-muted-foreground">
      <p class="text-sm">Le catalogue est en cours d'alimentation.</p>
    </div>
  </main>
</Layout>
