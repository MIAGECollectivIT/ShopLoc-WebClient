---
import type { ComponentType } from 'react';
import type { LucideProps } from 'lucide-react';

interface Props {
  title: string;
  description?: string;
  icon?: ComponentType<LucideProps>;
}

const { title, description, icon: Icon } = Astro.props;
---

<div class="max-w-5xl mx-auto p-4 sm:p-6 space-y-6">
  <header class="flex items-center gap-3 border-b pb-4">
    {Icon && <Icon className="size-6 text-primary shrink-0" />}
    <div>
      <h1 class="text-xl font-bold tracking-tight">{title}</h1>
      {description && <p class="text-xs text-muted-foreground">{description}</p>}
    </div>
  </header>

  <section class="space-y-4">
    <slot />
  </section>
</div>
